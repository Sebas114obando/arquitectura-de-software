# Auto-detect text files and normalize line endings to LF on checkout/commit
* text=auto eol=lf

# Explicit LF for source code and documentation
*.java text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.sh text eol=lf
mvnw text eol=lf

# Explicit CRLF for Windows command scripts
*.cmd text eol=crlf
*.bat text eol=crlf
